			<column name="started_at" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="status" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="status_history" type="Map(TIMESTAMP =&gt; TEXT, not frozen)" length="800" decimal="0" mandatory="y" />
