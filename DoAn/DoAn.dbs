<?xml version="1.0" encoding="UTF-8" ?>
<project name="Cassandra" database="Cassandra" id="586a9955-f5fb-45fe-95c9-153fa2496cd5" >
	<schema name="ride_booking" >
		<table name="customers" >
			<column name="customer_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="address" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="created_at" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="email" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="full_name" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="phone" type="TEXT" length="800" decimal="0" mandatory="y" />
		</table>
		<table name="driver_locations" >
			<column name="driver_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="day" type="DATE" length="800" decimal="0" mandatory="y" />
			<column name="ts" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="lat" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="lng" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="speed_kmh" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<index name="CLUSTER KEY" unique="UNIQUE_KEY" >
				<column name="ts" options="DESC" />
			</index>
		</table>
		<table name="drivers" >
			<column name="driver_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="full_name" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="license_number" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="phone" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="rating" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="status" type="TEXT" length="800" decimal="0" mandatory="y" />
		</table>
		<table name="drivers_by_area" >
			<column name="city" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="district" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="driver_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="full_name" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="last_seen" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="lat" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="lng" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="phone" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="rating" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="vehicle_plate" type="TEXT" length="800" decimal="0" mandatory="y" />
			<index name="CLUSTER KEY" unique="UNIQUE_KEY" >
				<column name="driver_id" />
			</index>
		</table>
		<table name="payments_by_city_date" >
			<column name="city" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="pay_date" type="DATE" length="800" decimal="0" mandatory="y" />
			<column name="payment_method" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="paid_at" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="ride_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="amount" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="customer_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="discount" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="district" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="driver_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<index name="CLUSTER KEY" unique="UNIQUE_KEY" >
				<column name="payment_method" />
				<column name="paid_at" options="DESC" />
				<column name="ride_id" />
			</index>
			<fk name="fk_payments_by_city_date_rides" virtual="y" to_schema="ride_booking" to_table="rides" >
				<fk_column name="ride_id" pk="ride_id" />
			</fk>
		</table>
		<table name="promotions" >
			<column name="promo_code" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="cities" type="Set(TEXT, not frozen)" length="800" decimal="0" mandatory="y" />
			<column name="description" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="discount_percent" type="INT" length="800" decimal="0" mandatory="y" />
			<column name="max_discount" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="min_fare" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="usage_limit" type="INT" length="800" decimal="0" mandatory="y" />
			<column name="used_count" type="INT" length="800" decimal="0" mandatory="y" />
			<column name="valid_from" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="valid_to" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
		</table>
		<table name="ratings_by_driver" >
			<column name="driver_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="rated_at" type="TIMESTAMP" length="800" decimal="0" mandatory="y" />
			<column name="ride_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="comment" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="customer_id" type="TEXT" length="800" decimal="0" mandatory="y" />
			<column name="stars" type="DOUBLE" length="800" decimal="0" mandatory="y" />
			<column name="tags" type="List(TEXT, not frozen)" length="800" decimal="0" mandatory="y" />
			<index name="CLUSTER KEY" unique="UNIQUE_KEY" >
				<column name="rated_at" options="DESC" />
				<column name="ride_id" />
			</index>
			<fk name="fk_ratings_by_driver_drivers" virtual="y" to_schema="ride_booking" to_table="drivers" >
				<fk_column name="driver_id" pk="driver_id" />
			</fk>
		</table>
