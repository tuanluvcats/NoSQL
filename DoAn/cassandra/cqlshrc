; cqlshrc cho đồ án: hiển thị đủ chữ số của kiểu double (mặc định cqlsh in 110000 thành 1.1e+05)
; Đã được docker-compose.yml gắn sẵn vào /root/.cassandra/cqlshrc của container nosql-cassandra-doan (không cần cài tay).
; Nếu chạy cqlsh ở nơi khác:  cqlsh --cqlshrc=/đường/dẫn/cqlshrc
[ui]
double_precision = 12
float_precision = 7
